{
  "name": "mint-lang",
  "displayName": "Mint",
  "description": "Mint proof assistant: syntax + live diagnostics via mintc",
  "version": "0.2.0",
  "main": "./extension.js",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:mint"],
  "contributes": {
    "languages": [{
      "id": "mint",
      "aliases": ["Mint"],
      "extensions": [".mint"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "mint",
      "scopeName": "source.mint",
      "path": "./syntaxes/mint.tmLanguage.json"
    }],
    "configuration": {
      "title": "Mint",
      "properties": {
        "mint.mintcPath": {
          "type": "string",
          "default": "",
          "description": "Path to the mintc binary. If empty, the extension looks for _build/default/src/mintc.bc.exe in the workspace root."
        },
        "mint.runOn": {
          "type": "string",
          "enum": ["save", "change"],
          "default": "save",
          "description": "Trigger re-elaboration on file save (default) or on every keystroke."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          { "scope": "variable.other.mint",       "settings": { "foreground": "#FFFFFF" } },
          { "scope": "constant.other.hole.mint",  "settings": { "foreground": "#E261C0" } },
          { "scope": "keyword.control.mint",      "settings": { "foreground": "#28DCE5" } },
          { "scope": "keyword.operator.mint",     "settings": { "foreground": "#28DCE5" } },
          { "scope": "entity.name.tag.mint",      "settings": { "foreground": "#FFD75F" } }
        ]
      }
    }
  }
}
