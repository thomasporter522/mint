{
  "scopeName": "source.mint",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#tags" },
    { "include": "#holes" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.mint"
    },
    "keywords": {
      "match": "\\b(postulate|meta|construct|by|end)\\b",
      "name": "keyword.control.mint"
    },
    "operators": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.mint" },
        { "match": ":",  "name": "keyword.operator.mint" }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.mint"
    },
    "tags": {
      "match": "#[a-zA-Z][a-zA-Z0-9_-]*",
      "name": "entity.name.tag.mint"
    },
    "holes": {
      "match": "\\?",
      "name": "constant.other.hole.mint"
    },
    "identifiers": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b",
      "name": "variable.other.mint"
    }
  }
}
