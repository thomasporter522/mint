{
  "scopeName": "source.mint",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#holes" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "match": "--.*$",
      "name": "comment.line.double-dash.mint"
    },
    "keywords": {
      "match": "\\b(postulate|meta|construct|by|end|schema|let|in|fun|match|with|if|then|else|Sort|Ok|Error|foldl|fst|snd)\\b",
      "name": "keyword.control.mint"
    },
    "operators": {
      "patterns": [
        { "match": "=>", "name": "keyword.operator.mint" },
        { "match": "->", "name": "keyword.operator.mint" },
        { "match": "==", "name": "keyword.operator.mint" },
        { "match": "!=", "name": "keyword.operator.mint" },
        { "match": "&&", "name": "keyword.operator.mint" },
        { "match": "\\|\\|", "name": "keyword.operator.mint" },
        { "match": "\\|", "name": "keyword.operator.mint" },
        { "match": ":", "name": "keyword.operator.mint" },
        { "match": "=", "name": "keyword.operator.mint" }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.mint"
    },
    "holes": {
      "match": "\\?",
      "name": "constant.other.hole.mint"
    },
    "identifiers": {
      "match": "\\b[a-zA-Z][a-zA-Z0-9_-]*\\b",
      "name": "variable.other.mint"
    }
  }
}
