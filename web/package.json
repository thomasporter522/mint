{
  "name": "artefact",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-grammar": "lezer-generator src/frontend/grammar/mint.grammar -o src/frontend/grammar/mint.grammar && sed -i '' 's|from \"./tokens\"|from \"./tokens.ts\"|g' src/frontend/grammar/mint.grammar.js && sed -i '' 's|from \"./mint.grammar.terms\"|from \"./mint.grammar.terms.js\"|g' src/frontend/grammar/mint.grammar.js src/frontend/grammar/tokens.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.8",
    "@lezer/lr": "^1.0.0",
    "@uiw/react-codemirror": "^4.25.3",
    "lezer": "^0.13.5",
    "lodash": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lezer/generator": "^1.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.6.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2"
  }
}
