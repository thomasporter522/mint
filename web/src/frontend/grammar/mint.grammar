@top Document { (Block | End_kw)* }

/* Standalone-expression mode for evalCode / checkSchemaCode / parseAndPrint
   on bare ML fragments. Allows top-level juxtaposition application that
   meta blocks don't. */
@top ExpressionTop { TopExpr }
TopExpr {
  Let | Match | Fun | If
| TopBinaryExpr
| AppInner
| AtomExpr
}
TopBinaryExpr {
  TopExpr !arrow "->" TopExpr
| TopExpr !asc ":" TopExpr
| TopExpr !cons "::" TopExpr
| TopExpr !cmp ("==" | "!=") TopExpr
| TopExpr !and "&&" TopExpr
| TopExpr !or "||" TopExpr
}

@context blockContext from "./tokens"

@external tokens terminatorTokenizer from "./tokens" { Terminator }

@skip { space | LineComment }

/* === Blocks ===
   Postulate and Construct are newline-terminated: the tokenizer emits
   Terminator at any newline that occurs at bracket-depth 0 while we're
   inside one of these blocks. Meta is whitespace-insensitive: the
   tokenizer suppresses Terminator there, so multi-line bodies need no
   wrapping. The block context is tracked by the parser-state-aware
   `blockContext` (see tokens.ts). */

Block { Postulate | Meta | Construct }

Postulate { Postulate_kw (Terminator | PostItem)+ }
Construct { Construct_kw By_kw Identifier (Terminator | PostItem)+ }
Meta      { Meta_kw      (Terminator | MetaItem)+ }

PostItem { Decl Terminator }

Decl {
  ItemHead (":" TypeExpr)?
}

ItemHead {
  Identifier Param*
| LParen Identifier Param* RParen
}

Param { LParen Identifier ":" TypeExpr RParen }

MetaItem {
  Schema_kw? Identifier (":" Expr)? "=" Expr
}

/* === Expressions === */

@precedence {
  let,
  fun,
  match,
  if,
  arrow @right,
  asc @right,
  cons @right,
  cmp @left,
  and @right,
  or @right,
  app @left
}

/* TypeExpr — used in postulate/construct decl types and param types.
   Allows top-level juxtaposition (e.g. `eq A B x y`). */
TypeExpr {
  TypeApp | TypeBinary | TypeAtom
}

TypeApp { TypeAtom (!app TypeAtom)+ }

TypeBinary {
  TypeExpr !arrow "->" TypeExpr
}

TypeAtom {
  Identifier
| Hole
| Wildcard
| StringLit
| LParen CommaSep<ParenInner>? RParen
| LBracket CommaSep<ParenInner>? RBracket
}

/* Expr — used in meta-let RHS, let-in bodies, match arm bodies, if branches.
   Does NOT allow top-level juxtaposition; apps must be parenthesized. */
Expr {
  Let | Match | Fun | If
| BinaryExpr
| AtomExpr
}

BinaryExpr {
  Expr !arrow "->" Expr
| Expr !asc ":" Expr
| Expr !cons "::" Expr
| Expr !cmp ("==" | "!=") Expr
| Expr !and "&&" Expr
| Expr !or "||" Expr
}

AtomExpr {
  Identifier
| Hole
| Wildcard
| StringLit
| LParen CommaSep<ParenInner>? RParen
| LBracket CommaSep<ParenInner>? RBracket
}

/* Inside parens/brackets, juxtaposition app IS allowed. ParenInner unifies
   the two top-level forms — TypeExpr-style app and Expr-style operators
   coexist via a hybrid rule. */
ParenInner {
  AppInner
| Let | Match | Fun | If
| BinaryInner
| AtomExpr
}

AppInner { AtomExpr (!app AtomExpr)+ }

BinaryInner {
  ParenInner !arrow "->" ParenInner
| ParenInner !asc ":" ParenInner
| ParenInner !cons "::" ParenInner
| ParenInner !cmp ("==" | "!=") ParenInner
| ParenInner !and "&&" ParenInner
| ParenInner !or "||" ParenInner
}

CommaSep<E> { E ("," E)* }

Let  { Let_kw  Identifier (":" Expr)? "=" Expr In_kw Expr }
Fun  { Fun_kw  Pattern+ "=>" Expr }
Match { Match_kw Expr With_kw MatchArm* End_kw }
MatchArm { "|" Pattern "=>" Expr }
If   { If_kw   Expr Then_kw Expr Else_kw Expr End_kw }

/* === Patterns === */

Pattern { PatBinary | PatApp | PatAtom }
PatBinary { Pattern !cons "::" Pattern }
PatApp { PatAtom (!app PatAtom)+ }
PatAtom {
  Wildcard
| Hole
| Identifier
| StringLit
| LParen CommaSep<Pattern>? RParen
| LBracket CommaSep<Pattern>? RBracket
}

/* === Tokens === */

@tokens {
  space { (" " | "\t" | "\r" | "\n")+ }
  LineComment { "--" ![\n]* }

  Identifier {
    @asciiLetter (@asciiLetter | @digit | "_")*
    ("-" (@asciiLetter | @digit | "_")+)*
  }

  Hole { "?" }
  Wildcard { "_" }

  StringLit { "\"" ![\"]* "\"" }

  LParen { "(" }
  RParen { ")" }
  LBracket { "[" }
  RBracket { "]" }

  "->" "=>" "==" "!=" "&&" "||" "::"
  ":" "=" "," "|"
}

/* Keywords as @specialize rules so they only match exact-word identifiers
   (not prefixes like `inl` containing `in`). Each rule name is exported
   in lytr.grammar.terms for the context tracker. */
Postulate_kw { @specialize<Identifier, "postulate"> }
Construct_kw { @specialize<Identifier, "construct"> }
Meta_kw      { @specialize<Identifier, "meta"> }
By_kw        { @specialize<Identifier, "by"> }
End_kw       { @specialize<Identifier, "end"> }
Schema_kw    { @specialize<Identifier, "schema"> }
Let_kw       { @specialize<Identifier, "let"> }
In_kw        { @specialize<Identifier, "in"> }
Match_kw     { @specialize<Identifier, "match"> }
With_kw      { @specialize<Identifier, "with"> }
Fun_kw       { @specialize<Identifier, "fun"> }
If_kw        { @specialize<Identifier, "if"> }
Then_kw      { @specialize<Identifier, "then"> }
Else_kw      { @specialize<Identifier, "else"> }

@detectDelim
